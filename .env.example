# URL pública do site (usada em links de convite e e-mails de recuperação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — valores exibidos por `supabase start` / `supabase status` (local)
# ou no dashboard do projeto (homologação/produção).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor — NUNCA expor ao navegador nem commitar valores reais.
# Ainda não utilizada na Fase 1; será exigida por webhooks/workers nas fases 4+.
SUPABASE_SERVICE_ROLE_KEY=
