# URL pública do site (usada em links de convite, e-mails e OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — valores exibidos por `supabase start` / `supabase status` (local)
# ou no dashboard do projeto (homologação/produção).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor — NUNCA expor ao navegador nem commitar valores reais.
SUPABASE_SERVICE_ROLE_KEY=

# Chave de criptografia dos tokens de integração (AES-256-GCM).
# Gere com: openssl rand -base64 32
INTEGRATION_TOKEN_KEY=

# Google Calendar (OAuth 2.0) — opcional até a integração ser ativada.
# Redirect autorizado: <NEXT_PUBLIC_SITE_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
